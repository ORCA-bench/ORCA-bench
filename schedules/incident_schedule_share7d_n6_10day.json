  "evaluation_criteria": {
    "isolated": {
      "description": "AI must identify a single root cause.",
      "pass_criteria": "Correctly identifies the single active flag."
    },
    "independent": {
      "description": "AI must identify multiple unrelated concurrent root causes.",
      "pass_criteria": "Enumerates all concurrent flags and asserts they share no symptoms."
    },
    "conflicting": {
      "description": "AI must distinguish concurrent root causes with overlapping symptoms.",
      "pass_criteria": "Enumerates all concurrent flags and attributes overlapping symptoms correctly."
    },
    "independent_cascading": {
      "description": "AI must determine containment order for non-overlapping cascade.",
      "pass_criteria": "Identifies outer>middle>inner and no symptom overlap."
    },
    "conflicting_cascading": {
      "description": "AI must determine containment order with overlapping symptoms.",
      "pass_criteria": "Identifies outer>middle>inner and flags overlapping pairs."
    },
    "deployment": {
      "description": "AI must recognize sequential rollout with overlapping symptoms.",
      "pass_criteria": "Identifies step1>step2>step3 order, canary variants, and rollout pattern."
    }
  }
}