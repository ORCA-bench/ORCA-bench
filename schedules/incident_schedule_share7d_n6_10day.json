{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "10-Day Incident Schedule (share-7d constraints, N=6 per type, Sun-FAFO Friday-weekend-Mon novel-Tue)",
  "metadata": {
    "version": "2.0-share7d-n6-10day",
    "author": "SRE Team",
    "purpose": "10-day N=6 schedule modeling Readonly-Friday: weekday buildup, Friday chaos peak, weekend bleeding/reoccurrence, Monday novel surface, Tuesday recovery. Flag-budget utilization near-maximal (58/60 flag-slots).",
    "theme_by_day": {
      "1": "Sunday \u2014 quiet warmup (2 Iso + Indep pair + Conflict pair)",
      "2": "Monday \u2014 ad CPU/GC cascade + afternoon catalog-payment canary",
      "3": "Tuesday \u2014 CDN-kafka-retry cascade + payment canary",
      "4": "Wednesday \u2014 ad cascade recurrence + canary",
      "5": "Thursday \u2014 ad-service flaky cascade + cart canary gone bad",
      "6": "FRIDAY FAFO \u2014 6 flags peak, adHighCpu bleeds 5h",
      "7": "Saturday \u2014 2AM cart reoccurrence, daytime image novel, ad pair returns, buried kafka",
      "8": "Sunday \u2014 1AM ad cascade recurs (5h), quiet catalog buried",
      "9": "Monday \u2014 novel rec-cache surfaces, cautious deploy, evening kafka+ad pair",
      "10": "Tuesday \u2014 morning kafka-imageSlow-adFailure cascade + normal catalog canary"
    }
  },
