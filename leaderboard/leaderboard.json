{
  "package": "orca-bench/orca-bench",
  "name": "orca-bench",
  "title": "ORCA-bench",
  "description": "Leaderboard for ORCA-bench: root cause analysis for oncall agents",
  "visibility": "private",
  "metadata_schema": {
    "type": "object",
    "properties": {
      "agent_display": { "type": "string", "minLength": 1 },
      "model_display": { "type": "string", "minLength": 1 },
      "agent_org": { "type": "string", "minLength": 1 },
      "model_org": { "type": "string", "minLength": 1 },
      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "reasoning_effort": { "type": "string" },
      "pr": { "type": "string", "minLength": 1 }
    },
    "required": ["agent_display", "model_display", "agent_org", "model_org", "date"],
    "additionalProperties": false
  },
  "metrics_schema": {
    "type": "object",
    "properties": {
      "accuracy": { "type": "number", "minimum": 0, "maximum": 100 },
      "accuracy_stderr": { "type": "number", "minimum": 0, "maximum": 100 },
      "accuracy_incident": { "type": "number", "minimum": 0, "maximum": 100 },
      "accuracy_control": { "type": "number", "minimum": 0, "maximum": 100 },
      "accuracy_incident_easy": { "type": "number", "minimum": 0, "maximum": 100 },
      "accuracy_incident_medium": { "type": "number", "minimum": 0, "maximum": 100 },
      "accuracy_incident_hard": { "type": "number", "minimum": 0, "maximum": 100 },
      "rca_accuracy_incident": { "type": "number", "minimum": 0, "maximum": 100 },
      "rca_accuracy_incident_easy": { "type": "number", "minimum": 0, "maximum": 100 },
      "rca_accuracy_incident_medium": { "type": "number", "minimum": 0, "maximum": 100 },
      "rca_accuracy_incident_hard": { "type": "number", "minimum": 0, "maximum": 100 },
      "total_tokens": { "type": "number", "minimum": 0 },
      "total_cost_usd": { "type": "number", "minimum": 0 }
    },
    "required": ["accuracy", "accuracy_stderr"],
    "additionalProperties": false
  },
  "columns": [
    { "id": "agent_display",     "header": "Agent",            "accessor": "metadata.agent_display",     "type": "text" },
    { "id": "model_display",     "header": "Model",            "accessor": "metadata.model_display",     "type": "text" },
    { "id": "reasoning_effort",  "header": "Reasoning Effort", "accessor": "metadata.reasoning_effort",  "type": "text" },
    { "id": "date",              "header": "Date",             "accessor": "metadata.date",              "type": "date" },
    { "id": "agent_org",         "header": "Agent Org",        "accessor": "metadata.agent_org",         "type": "text" },
    { "id": "model_org",         "header": "Model Org",        "accessor": "metadata.model_org",         "type": "text" },
    { "id": "accuracy",          "header": "Accuracy (%)",     "accessor": "metrics.accuracy",           "type": "number", "align": "right" },
    { "id": "accuracy_stderr",   "header": "± SE",             "accessor": "metrics.accuracy_stderr",    "type": "number", "align": "right" },

    { "id": "accuracy_incident",            "header": "Reward: Incident",        "accessor": "metrics.accuracy_incident",            "type": "number", "align": "right" },
    { "id": "accuracy_control",             "header": "Reward: Control",         "accessor": "metrics.accuracy_control",             "type": "number", "align": "right" },
    { "id": "accuracy_incident_easy",       "header": "Reward: Easy",            "accessor": "metrics.accuracy_incident_easy",       "type": "number", "align": "right" },
    { "id": "accuracy_incident_medium",     "header": "Reward: Medium",          "accessor": "metrics.accuracy_incident_medium",     "type": "number", "align": "right" },
    { "id": "accuracy_incident_hard",       "header": "Reward: Hard",            "accessor": "metrics.accuracy_incident_hard",       "type": "number", "align": "right" },

    { "id": "rca_accuracy_incident",        "header": "RCA: Incident",           "accessor": "metrics.rca_accuracy_incident",        "type": "number", "align": "right" },
    { "id": "rca_accuracy_incident_easy",   "header": "RCA: Easy",               "accessor": "metrics.rca_accuracy_incident_easy",   "type": "number", "align": "right" },
    { "id": "rca_accuracy_incident_medium", "header": "RCA: Medium",             "accessor": "metrics.rca_accuracy_incident_medium", "type": "number", "align": "right" },
    { "id": "rca_accuracy_incident_hard",   "header": "RCA: Hard",               "accessor": "metrics.rca_accuracy_incident_hard",   "type": "number", "align": "right" },

    { "id": "total_tokens",      "header": "Tokens",           "accessor": "metrics.total_tokens",       "type": "number", "align": "right" },
    { "id": "total_cost_usd",    "header": "Cost",             "accessor": "metrics.total_cost_usd",     "type": "number", "align": "right" },
    { "id": "pr",                "header": "PR",               "accessor": "metadata.pr",                "type": "markdown" }
  ],
  "rank_by": [
    { "accessor": "metrics.accuracy", "direction": "desc" }
  ]
}
