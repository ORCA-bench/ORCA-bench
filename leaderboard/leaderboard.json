{
  "package": "orca-bench/orca-bench",
  "name": "orca-bench",
  "title": "ORCA-bench",
  "description": "Leaderboard for ORCA-bench: root cause analysis for oncall agents",
  "visibility": "private",
  "metadata_schema": {
    "type": "object",
    "properties": {
      "agent_display": {
        "type": "string",
        "minLength": 1
      },
      "model_display": {
        "type": "string",
        "minLength": 1
      },
      "agent_org": {
        "type": "string",
        "minLength": 1
      },
      "model_org": {
        "type": "string",
        "minLength": 1
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "reasoning_effort": {
        "type": "string"
      },
      "pr": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "agent_display",
      "model_display",
      "agent_org",
      "model_org",
      "date"
    ],
    "additionalProperties": false
  },
  "metrics_schema": {
    "type": "object",
    "properties": {
      "rca_accuracy_incident_medium": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "rca_accuracy_incident_medium_stderr": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "rca_accuracy_incident_medium_display": {
        "type": "string",
        "minLength": 1
      },
      "rca_accuracy_incident_hard": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "rca_accuracy_incident_hard_stderr": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "rca_accuracy_incident_hard_display": {
        "type": "string",
        "minLength": 1
      },
      "hallucinate_any_incident": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "hallucinate_any_incident_stderr": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "hallucinate_any_incident_display": {
        "type": "string",
        "minLength": 1
      },
      "total_tokens": {
        "type": "number",
        "minimum": 0
      },
      "total_cost_usd": {
        "type": "number",
        "minimum": 0
      }
    },
    "required": [
      "rca_accuracy_incident_medium",
      "rca_accuracy_incident_medium_stderr",
      "rca_accuracy_incident_medium_display",
      "rca_accuracy_incident_hard",
      "rca_accuracy_incident_hard_stderr",
      "rca_accuracy_incident_hard_display",
      "hallucinate_any_incident",
      "hallucinate_any_incident_stderr",
      "hallucinate_any_incident_display"
    ],
    "additionalProperties": false
  },
  "columns": [
    {
      "id": "agent_display",
      "header": "Agent",
      "accessor": "metadata.agent_display",
      "type": "text"
    },
    {
      "id": "model_display",
      "header": "Model",
      "accessor": "metadata.model_display",
      "type": "text"
    },
    {
      "id": "reasoning_effort",
      "header": "Reasoning Effort",
      "accessor": "metadata.reasoning_effort",
      "type": "text"
    },
    {
      "id": "date",
      "header": "Date",
      "accessor": "metadata.date",
      "type": "date"
    },
    {
      "id": "agent_org",
      "header": "Agent Org",
      "accessor": "metadata.agent_org",
      "type": "text"
    },
    {
      "id": "model_org",
      "header": "Model Org",
      "accessor": "metadata.model_org",
      "type": "text"
    },
    {
      "id": "rca_accuracy_incident_medium_display",
      "header": "RCA Accuracy (Medium)",
      "accessor": "metrics.rca_accuracy_incident_medium_display",
      "type": "text",
      "align": "right"
    },
    {
      "id": "rca_accuracy_incident_hard_display",
      "header": "RCA Accuracy (Hard)",
      "accessor": "metrics.rca_accuracy_incident_hard_display",
      "type": "text",
      "align": "right"
    },
    {
      "id": "hallucinate_any_incident_display",
      "header": "Hallucination Rate",
      "accessor": "metrics.hallucinate_any_incident_display",
      "type": "text",
      "align": "right"
    },
    {
      "id": "total_tokens",
      "header": "Tokens",
      "accessor": "metrics.total_tokens",
      "type": "number",
      "align": "right"
    },
    {
      "id": "total_cost_usd",
      "header": "Cost",
      "accessor": "metrics.total_cost_usd",
      "type": "number",
      "align": "right"
    },
    {
      "id": "pr",
      "header": "PR",
      "accessor": "metadata.pr",
      "type": "markdown"
    }
  ],
  "rank_by": [
    {
      "accessor": "metrics.rca_accuracy_incident_medium",
      "direction": "desc"
    }
  ]
}
